      "parameters": {
        "jsCode": "const items=$input.all(),result=[];\n// Read binary while it is present on this node input. Crypto deliberately drops processed binary fields.\nfor(let i=0;i<items.length;i++){const buffer=await this.helpers.getBinaryDataBuffer(i,'data');if(buffer.length!==items[i].json.bytes)throw Error('E_SOURCE_SIZE');result.push({json:{...items[i].json,actualBytes:buffer.length,contentBase64:buffer.toString('base64')},binary:items[i].binary});}\nreturn result;"
      }
