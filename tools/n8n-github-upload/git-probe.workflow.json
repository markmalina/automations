    {
      "id": "03c41ab9-27a1-4a0a-83f4-c65198169575",
      "name": "Create relative directories",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "parameters": {
        "command": "={{ (() => { const p=$('Prepare upload').first().json; const dirs=p.manifest.files.map(f=>p.repoPath+'/'+p.prefix+f.path).map(s=>s.slice(0,s.lastIndexOf('/'))); const quote=s=>\"'\"+s.replace(/'/g,\"'\\\\''\")+\"'\";return 'mkdir -p -- '+[...new Set(dirs)].map(quote).join(' '); })() }}",
        "executeOnce": true
      },
      "position": [
        0,
