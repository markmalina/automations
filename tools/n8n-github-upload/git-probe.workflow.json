      "typeVersion": 2,
      "parameters": {
        "jsCode": "const items=$input.all();const binary=$('Authenticated binary webhook').first().binary;for(const i of items){if(i.json.sha256!==i.json.actualSha256)throw new Error('Source digest mismatch');i.binary={data:binary[i.json.field]};}return items;"
