    {
      "id": "958f8635-93b9-452c-9c6f-d4dfba4460e7",
      "name": "Prepare upload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const input=$input.first(); const m=JSON.parse(input.json.body.manifest);\nif(!/^[a-f0-9-]{36}$/.test(m.uploadId||'') || !Array.isArray(m.files) || m.files.length<1 || m.files.length>100) throw new Error('Invalid pilot manifest');\nif(Object.keys(input.binary||{}).length!==m.files.length) throw new Error('File count mismatch');\nconst seen=new Set();\nfor(const f of m.files){if(!input.binary[f.field] || !/^[a-f0-9]{64}$/.test(f.sha256) || !Number.isSafeInteger(f.bytes) || f.bytes<0 || !f.path || f.path.startsWith('/') || /[\\\\\\u0000]/.test(f.path) || f.path.split('/').some(p=>!p||p==='.'||p==='..'||p.toLowerCase()==='.git') || seen.has(f.path.normalize('NFC')) || /[,\\r\\n]/.test(f.path))throw new Error('Invalid file');seen.add(f.path.normalize('NFC'));}\nif(m.files.reduce((n,f)=>n+f.bytes,0)>32000000)throw new Error('Pilot size limit');\nconst prefix='n8n-retry-tests/'+m.uploadId+'/';\nreturn [{json:{manifest:m,repoPath:'/data/work/git/pilot-'+m.uploadId,prefix,started:Date.now(),owner:$execution.id,grant:input.json.headers['x-work-upload-grant']}}];"
      },
      "position": [
        250,
        0
      ]
