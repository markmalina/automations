      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "if(!['ahead','identical'].includes($json.status))throw Error('REMOTE_NOT_CONFIRMED');\nconst p=$('Prepare upload').first().json;const record=$('Parse claim').first().json;\nconst sha=record.commitSha||$('Known commit').first().json.commitSha;\nconst receipt=record.receipt||{success:true,repository:'markmalina/freelance',branch:'test/n8n-upload-20261106',commitSha:sha,url:'https://github.com/markmalina/freelance/commit/'+sha,uploadId:p.manifest.uploadId,fileCount:p.manifest.files.length,totalBytes:p.manifest.files.reduce((n,f)=>n+f.bytes,0),files:p.manifest.files.map(f=>({path:p.prefix+f.path,sourcePath:f.path,sha256:f.sha256,bytes:f.bytes})),productionReady:false};\nreturn [{json:{receipt,replayed:record.route==='verify',processingMs:Date.now()-p.started}}];"
